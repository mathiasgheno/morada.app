{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morada",
  "version": "0.1.0",
  "identifier": "app.morada.desktop",
  "build": {
    "beforeDevCommand": "bun desktop/dev-server.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun desktop/prepare.mjs",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Seus projetos · Morada",
      "url": "launcher.html",
      "width": 460,
      "height": 760,
      "minWidth": 360,
      "minHeight": 520
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
