{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morada",
  "version": "0.1.0",
  "identifier": "app.morada.desktop",
  "build": {
    "beforeDevCommand": "bun desktop/dev-server.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun desktop/prepare.mjs",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Seus projetos · Morada",
      "url": "launcher.html",
      "width": 1180,
      "height": 800,
      "minWidth": 900,
      "minHeight": 600
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
